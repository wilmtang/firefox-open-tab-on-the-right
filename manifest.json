{
  "manifest_version": 2,
  "name": "Open Tab on the Right",
  "version": "2.1",
  "description": "Opens a new tab to the right of the current active tab with a customizable shortcut.",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "open-tab-right": {
      "suggested_key": {
        "default": "Ctrl+Alt+T",
        "mac": "Command+Alt+T"
      },
      "description": "Open new tab to the right"
    },
    "move-tab-prev": {
      "suggested_key": {
        "default": "Ctrl+Alt+Left",
        "mac": "MacCtrl+Command+Left"
      },
      "description": "Move tab to the left"
    },
    "move-tab-next": {
      "suggested_key": {
        "default": "Ctrl+Alt+Right",
        "mac": "MacCtrl+Command+Right"
      },
      "description": "Move tab to the right"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{61a45ae9-6056-42fc-b02b-44c36005271d}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
