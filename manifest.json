{
  "manifest_version": 2,
  "name": "Open Tab on the Right",
  "version": "1.0",
  "description": "Opens a new tab to the right of the current active tab with a customizable shortcut.",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "open-tab-right": {
      "suggested_key": {
        "default": "Ctrl+Alt+T",
        "mac": "Command+Alt+T"
      },
      "description": "Open new tab to the right"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  }
}
