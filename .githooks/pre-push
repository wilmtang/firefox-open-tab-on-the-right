#!/bin/bash

# pre-push hook: block pushing a release tag (vX.Y) whose version does not match
# manifest.json. It only verifies — it never commits, retags, or pushes for you.

while read -r local_ref local_sha remote_ref remote_sha
do
    if [[ $local_ref == refs/tags/v* ]]; then
        TAG_NAME=${local_ref#refs/tags/}
        VERSION=${TAG_NAME#v}

        [ -f manifest.json ] || continue

        MANIFEST_VERSION=$(grep -o '"version": *"[^"]*"' manifest.json | head -1 | awk -F '"' '{print $4}')

        if [ "$VERSION" != "$MANIFEST_VERSION" ]; then
            echo "❌ Tag $TAG_NAME (version $VERSION) does not match manifest.json version $MANIFEST_VERSION." >&2
            echo "   Fix it, then retag:" >&2
            echo "     1. Update \"version\" in manifest.json and commit." >&2
            echo "     2. git tag -d $TAG_NAME && git tag $TAG_NAME" >&2
            echo "     3. git push origin $TAG_NAME" >&2
            exit 1
        fi
    fi
done

exit 0
